#!/usr/bin/env bash
#MISE description="Re-run the release workflow (multi-arch build + GitHub release + Docker push) for the given (or latest) tag"
set -euo pipefail

tag="${1:-$(git describe --tags --abbrev=0)}"

# The release workflow builds linux/amd64+arm64 and darwin/amd64+arm64
# natively (CGO — see docs/design/duckdb-storage.md — rules out
# cross-compiling all of those from a single local machine), then pushes
# multi-platform Docker images via buildx. That's a strict superset of what
# this task used to do locally with `goreleaser release` + dockers_v2, and
# runs on real native runners instead of approximating cross-arch locally
# through Docker's Linux VM — so re-dispatch release.yml's own escape hatch
# (see its workflow_dispatch trigger) rather than reimplementing the
# pipeline here.
gh workflow run release.yml -f "tag=$tag"
echo "Triggered release.yml for $tag — follow with: gh run watch"
